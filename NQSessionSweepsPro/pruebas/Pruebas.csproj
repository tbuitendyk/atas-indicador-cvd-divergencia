<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas sin ATAS ni Windows: compila el núcleo (Nucleo/) y el indicador real (Atas/) contra los sustitutos
       de comportamiento de StubsAtas.cs. Se ejecuta con pruebas/verificar.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\Nucleo\*.cs" LinkBase="Nucleo" />
  </ItemGroup>

</Project>
