<Project>

  <!-- ThermalVolumeProfile es autónomo: este archivo sustituye al Directory.Build.props de la raíz del repositorio
       (MSBuild usa el más cercano), así que la carpeta se puede copiar y compilar sola. -->
  <PropertyGroup>
    <!-- Debe coincidir con el runtime de la plataforma ATAS instalada (las versiones actuales usan .NET 10). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Solo para el tipo de color de los ajustes (System.Windows.Media.Color), como los demás indicadores del
         repositorio. No hay ventanas WPF. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Carpeta de instalación de ATAS. Si ATAS está en otra ruta, cámbiela aquí o pásela al compilar:
         dotnet build /p:ATAS_BASE="D:\ATAS Platform" -->
    <ATAS_BASE Condition="'$(ATAS_BASE)' == ''">C:\Program Files (x86)\ATAS Platform</ATAS_BASE>
  </PropertyGroup>

  <!-- Ensamblados de la plataforma, tomados de la instalación de ATAS.
       Private=false: no se copian a la salida, ATAS ya los tiene cargados. -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(ATAS_BASE)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(ATAS_BASE)\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(ATAS_BASE)\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Selector de sonidos ([SoundComboBoxEditor]) y máscaras de fecha y hora ([Mask]). -->
    <Reference Include="OFT.Attributes">
      <HintPath>$(ATAS_BASE)\OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(ATAS_BASE)\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
